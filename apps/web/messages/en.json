  "Home": {
    "heroTitle": "You always know what to do, when and how",
    "heroHighlight": "what to do, when and how",
    "heroDescription": "QualiDji transforms ISO 9001 and ISO 22000 requirements into a daily flow of small, guided, proven and verified tasks. Adapted to your company size and each user's level.",
    "startFree": "Start free diagnostic",
    "login": "Sign in",
    "featuresTitle": "Why QualiDji?",
    "featureEngine": {
      "title": "Requirements engine",
      "description": "Each clause of the standard becomes a dated, guided task. You never read the standard — you follow your list."
    },
    "featureEvidence": {
      "title": "Graduated trust evidence",
      "description": "Timestamped photos, geolocation, sensors, dual validation. Every action leaves evidence an auditor can trust."
    },
    "featureAdaptive": {
      "title": "Adaptive guidance",
      "description": "Three interface modes (Guided, Assisted, Expert) that adapt to each user's level, from novice to expert."
    },
    "featureAuditors": {
      "title": "Two auditor spaces",
      "description": "Internal and external auditors in separate spaces. The external portal reduces on-site audit duration."
    },
    "featureDjibouti": {
      "title": "Built for Djibouti",
      "description": "French, Arabic, Somali and Afar. Offline for unreliable connectivity. Mobile money payment (D-Money, Waafi)."
    },
    "featureAntiCheat": {
      "title": "Structural anti-cheating",
      "description": "Role separation, random verification, tamper-proof log, anomaly detection. Cheating is harder than honesty."
    },
    "footerTagline": "SaaS platform for ISO compliance management",
    "footerSubtitle": "ISO 9001:2015 & ISO 22000:2018 — Djibouti"
  },
