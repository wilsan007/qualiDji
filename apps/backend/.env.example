# Backend — même adresse Supabase conservée de l'ancien projet
SUPABASE_URL=https://dtpxqxyjgfykzqftecrq.supabase.co
SUPABASE_ANON_KEY=sb_publishable_3Waxxan2EKkis0cFtkCdeA_jAwRoIfP
# Clé service_role requise pour appliquer les migrations / RLS (à renseigner)
SUPABASE_SERVICE_ROLE_KEY=
PORT=4000
# Origines CORS autorisées, séparées par des virgules.
# En production : une seule origine (le domaine du frontend déployé).
# En développement : http://localhost:5173,http://localhost:5174
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Derrière un reverse proxy : nombre de proxys de confiance (ex. 1). Vide = aucun proxy.
# Sans cette variable, tous les utilisateurs partagent le quota de limitation de débit.
TRUST_PROXY=
# Preuves : taille max (octets, défaut 26214400 = 25 Mio) et durée des URL signées (s, défaut 300)
# EVIDENCE_MAX_BYTES=26214400
# EVIDENCE_URL_TTL_S=300
